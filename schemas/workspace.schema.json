{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name. The folder name is the workspace's id."
    },
    "description": {
      "type": "string"
    },
    "chief_of_staff": {
      "default": "chief-of-staff",
      "description": "The agent file (in agents/) that is the workspace's chief of staff.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "accounts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "description": "Install accounts this workspace may use. Each agent picks from these."
    },
    "channels": {
      "default": {},
      "description": "Named channels. `chat`, `approvals` and `updates` are the built-in ones; workflows may post to others, such as `briefs`.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "connection": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "The install connection that carries it, such as `slack`."
              },
              "channel": {
                "type": "string",
                "minLength": 1,
                "description": "The channel's id or name in that service."
              }
            },
            "required": [
              "connection",
              "channel"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "connection": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "The install connection that carries it, such as `slack`."
              },
              "direct": {
                "type": "boolean",
                "const": true,
                "description": "Direct messages with the connection's bot. Only one workspace per connection can have them."
              }
            },
            "required": [
              "connection",
              "direct"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "integrations": {
      "default": {},
      "description": "Install connections this workspace may use, with the access it gets.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "access": {
            "default": "read",
            "type": "string",
            "enum": [
              "read",
              "full"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "isolation": {
      "default": "enforced",
      "description": "`enforced`: its own folder, Claude Code config, permission rules, secrets and account. `hard`: a separate machine, VM or user account.",
      "type": "string",
      "enum": [
        "enforced",
        "hard"
      ]
    },
    "skill_budget": {
      "default": 20,
      "description": "Doctor warns when the workspace or one agent goes past this many skills.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "knowledge": {
      "default": {
        "note_after_idle": 30,
        "tidy_at": "03:00"
      },
      "description": "How the workspace's knowledge loop runs.",
      "type": "object",
      "properties": {
        "note_after_idle": {
          "default": 30,
          "description": "Minutes a conversation stays quiet, after new work, before Wheems asks its agent for a note. 0 turns this off.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filer": {
          "description": "The agent that files notes into the knowledge base.",
          "type": "object",
          "properties": {
            "engine": {
              "description": "Defaults to the chief of staff's engine.",
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "model": {
              "description": "Defaults to Claude Sonnet on Claude Code, else the chief of staff's model.",
              "type": "string",
              "minLength": 1
            },
            "account": {
              "description": "Defaults to the chief of staff's account.",
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "additionalProperties": false
        },
        "tidy_at": {
          "default": "03:00",
          "description": "When the nightly tidy runs, in local time: the filer writes reports/contradictions.md and reports/stale.md and refreshes the brief. false turns it off.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "default": {
        "max_open_per_owner": 3,
        "max_depth": 2
      },
      "description": "Limits on ad-hoc sessions, so they cannot multiply or loop.",
      "type": "object",
      "properties": {
        "max_open_per_owner": {
          "default": 3,
          "description": "Most open ad-hoc sessions one owner (a chief, a session or you) may have.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_depth": {
          "default": 2,
          "description": "How many levels of ad-hoc sessions may start one another: 2 lets a chief's session start one, and that one start one more.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "machine": {
      "description": "The machine agents run on by default.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "identity": {
      "description": "The name and icon the workspace's posts appear under, where the channel supports it.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "description": "An emoji such as `:house:`, or an image URL.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "default": {
        "chief_decides": []
      },
      "description": "Which decisions the chief of staff makes, and which it brings to the person.",
      "type": "object",
      "properties": {
        "chief_decides": {
          "default": [],
          "description": "Kinds of decision that are usually the person's, left to the chief in this workspace: `money`, `speaking` (for the person, to anyone outside), `irreversible`, `access` and `outside` (the ask). Only the person changes this.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "money",
              "speaking",
              "irreversible",
              "access",
              "outside"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "default": [],
      "description": "Rules written once and enforced at every layer that can enforce them.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "project": {
            "description": "Limit the rule to one project.",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "deny": {
            "description": "Actions it refuses, each with the targets it refuses them for (branches, servers).",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "require": {
            "description": "Something that must happen first, such as a review before a merge.",
            "type": "object",
            "properties": {
              "review": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "before": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            },
            "required": [
              "review",
              "before"
            ],
            "additionalProperties": false
          },
          "action": {
            "description": "The action this rule is about, for `approval`.",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "approval": {
            "description": "The channel that must approve `action` first.",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "accounts"
  ],
  "additionalProperties": false,
  "$id": "https://wheems.dev/schemas/workspace.schema.json",
  "title": "Wheems workspace.yaml"
}
