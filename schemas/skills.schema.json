{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skills": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "A library version or content hash"
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://opinr.dev/schemas/skills.schema.json",
  "title": "Opinr skills.yaml"
}
