{
  "name": "wheems",
  "version": "0.1.13",
  "description": "An opinionated framework for running teams of AI agents, on Herdr core",
  "license": "Apache-2.0",
  "homepage": "https://wheems.dev",
  "bugs": {
    "url": "https://github.com/wheems-dev/wheems/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "agent-harness",
    "claude-code",
    "codex",
    "opencode",
    "herdr",
    "slack",
    "automation",
    "workflows",
    "knowledge-base",
    "cli"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "wheems": "src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "src",
    "dist/web/app",
    "schemas",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/build-web.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "bun test --timeout 20000",
    "test:watch": "bun test --timeout 20000 --watch",
    "schemas": "bun scripts/write-schemas.ts",
    "wheems": "bun src/cli/main.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run check",
    "dev:web": "bun scripts/dev-web.ts",
    "compile": "bun scripts/compile.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wheems-dev/wheems.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.3.0",
    "commander": "^15.1.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "5.105.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
