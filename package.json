{
  "name": "wheems",
  "version": "0.0.1",
  "description": "An opinionated framework for running teams of AI agents, on Herdr core",
  "license": "Apache-2.0",
  "homepage": "https://wheems.dev",
  "bugs": {
    "url": "https://github.com/wheems-dev/wheems/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "agent-harness",
    "claude-code",
    "codex",
    "opencode",
    "herdr",
    "slack",
    "automation",
    "workflows",
    "knowledge-base",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "wheems": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "schemas",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "tsx scripts/write-schemas.ts",
    "wheems": "tsx src/cli/main.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wheems-dev/wheems.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.3.0",
    "commander": "^15.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
